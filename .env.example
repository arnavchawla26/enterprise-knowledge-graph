# Copy to .env (gitignored). Never commit .env.
# Neo4j (docker-compose.yml and src/ekg/config.py read these)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ekg_local_dev_only
# Read-only user the text-to-Cypher tool and the API use (created by `make load`)
NEO4J_READER_USER=ekg_reader
NEO4J_READER_PASSWORD=ekg_reader_local_dev_only
# Project 1 (services-ops-intelligence): its Postgres and its files are read-only inputs
SOIS_REPO=../services-ops-intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sois
POSTGRES_PASSWORD=sois_local_dev_only
POSTGRES_DB=sois
# Elasticsearch / Kibana
ES_URL=http://localhost:9200
KIBANA_URL=http://localhost:5601
# Model backends for ekg.nl2cypher (optional; eval reruns come from cache/)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
